{
  "credentials": {
    "_comment": "API key from BizyAir Settings -> API Keys. The CLI uses Bearer auth against api.bizyair.ai / meta.bizyair.ai directly.",
    "api_key": "sk-YOUR_BIZYAIR_API_KEY_HERE"
  },
  "client": {
    "_comment": "API key mode targets api.bizyair.ai / meta.bizyair.ai directly.",
    "api_host": "https://api.bizyair.ai",
    "meta_host": "https://meta.bizyair.ai",
    "locale": "en"
  },
  "batch": {
    "_comment": "User-facing batch caps backed by the same plan-level guards.",
    "max_concurrency": 3,
    "max_tasks": 5
  },
  "polling": {
    "interval_seconds": 5,
    "max_seconds": 900
  }
}
